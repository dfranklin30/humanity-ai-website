# ============================================================
# Humanity + AI — Google Cloud deployment settings
# Copy this file to env.deploy and fill in each value.
# Lines starting with # are comments.
# ============================================================

# Google Cloud project ID (you choose this when creating the project)
GCP_PROJECT_ID=humanity-plus-ai

# Region for Cloud Run (us-east1 = South Carolina, good for East Coast)
GCP_REGION=us-east1

# --- Database (Neon) ---
# The connection string from your NEW Neon database (starts with postgres://)
DATABASE_URL=

# --- Sessions ---
# Any long random string; keeps users logged in securely.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# --- Site URL ---
APP_URL=https://humanityplusai.org

# --- AI (Google Gemini, free tier) ---
# Key from https://aistudio.google.com/apikey
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Stripe (donations) ---
# Live secret key from https://dashboard.stripe.com/apikeys (starts with sk_live_)
STRIPE_SECRET_KEY=

# --- Email notifications (Gmail) ---
# Same values you had in Replit Secrets
GMAIL_USER=
GMAIL_APP_PASSWORD=
EVENT_ADMIN_EMAIL=

# --- Slack community feed ---
# Bot token (starts with xoxb-) from your Slack app
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=C0BC09PDR9Q

Claude outputs/

# ---------------------------------------------------------------------------
# EAS Build only (this file replaces .gitignore for `eas build`).
# The Android/iOS app needs the mobile package, the shared lib/ packages and
# the workspace manifests. Everything heavy that the app never uses stays
# home, which keeps the upload small enough not to drop (build 15 tried to
# send 686 MB). Each other workspace keeps its package.json so the install
# still matches pnpm-lock.yaml.
# ---------------------------------------------------------------------------
/media/
/attached_assets/
/Claude outputs/
/artifacts/humanity-ai-website/*
!/artifacts/humanity-ai-website/package.json
/artifacts/api-server/*
!/artifacts/api-server/package.json
/artifacts/mockup-sandbox/*
!/artifacts/mockup-sandbox/package.json
